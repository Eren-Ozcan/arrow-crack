{
  "name": "arrow-crack",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "levels:manifest": "tsx tools/generate-manifest.ts",
    "levels:validate": "tsx tools/validate-levels.ts",
    "levels:generate": "tsx tools/generate-levels.ts",
    "size": "tsx tools/check-size.ts",
    "cap:sync": "npm run build && cap sync android",
    "android:dev": "npm run cap:sync && cap run android",
    "test:coverage": "vitest run --coverage",
    "levels:solve": "tsx tools/solve.ts",
    "art:shoot": "tsx tools/shoot.ts"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@eslint/js": "^9.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^17.12.0",
    "prettier": "^3.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0"
  }
}
